<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/22.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.reminder.edu.controller.SlaveController">
   <children>
      <VBox prefHeight="800.0" prefWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #e0e0e0;" VBox.vgrow="NEVER">
               <children>
                  <Label text="Порт:">
                     <HBox.margin>
                        <Insets left="10.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="portNames" prefWidth="150.0" />
                  <Label text="Скорость:">
                     <HBox.margin>
                        <Insets left="20.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="baudRate" prefWidth="100.0" />
                  <Label text="Биты данных:">
                     <HBox.margin>
                        <Insets left="20.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="dataBits" prefWidth="80.0" />
                  <Label text="Чётность:">
                     <HBox.margin>
                        <Insets left="20.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="parity" prefWidth="100.0" />
                  <Label text="Стоп-биты:">
                     <HBox.margin>
                        <Insets left="20.0" right="5.0" />
                     </HBox.margin>
                  </Label>
                  <ComboBox fx:id="stopBits" prefWidth="80.0" />
                  <Button fx:id="btnOpen" onAction="#handleOpenConnection" text="Подключить">
                     <HBox.margin>
                        <Insets left="20.0" right="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="btnClose" onAction="#handleCloseConnection" text="Отключить">
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <SplitPane dividerPositions="0.65" orientation="VERTICAL" VBox.vgrow="ALWAYS">
               <items>
                  <ScrollPane fitToHeight="true" fitToWidth="true">
                     <content>
                        <TableView fx:id="sensorsTable" prefHeight="400.0" prefWidth="1178.0">
                          <columns>
                            <TableColumn fx:id="sensorIdCol" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="sensorTypeCol" prefWidth="120.0" text="Тип" />
                            <TableColumn fx:id="sensorNameCol" prefWidth="200.0" text="Имя" />
                            <TableColumn fx:id="sensorAddressCol" prefWidth="70.0" text="Адрес" />
                            <TableColumn fx:id="sensorEnabledCol" prefWidth="60.0" text="Вкл" />
                            <TableColumn fx:id="sensorStateCol" prefWidth="120.0" text="Состояние" />
                            <TableColumn fx:id="sensorValueCol" prefWidth="150.0" text="Значение" />
                            <TableColumn fx:id="sensorActionsCol" prefWidth="250.0" text="Действия" />
                          </columns>
                        </TableView>
                     </content>
                  </ScrollPane>
                  <VBox prefHeight="200.0">
                     <children>
                        <Label text="Лог событий:">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextArea fx:id="logArea" editable="false" prefHeight="150.0" VBox.vgrow="ALWAYS" />
                     </children>
                  </VBox>
               </items>
            </SplitPane>
         </children>
      </VBox>
   </children>
</AnchorPane>
